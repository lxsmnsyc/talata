{
  "exclude": ["node_modules"],
  "include": ["src", "test"],
  "compilerOptions": {
    "module": "ESNext",
    "lib": ["ESNext"],
    "types": ["node"],
    "importHelpers": true,
    "declaration": true,
    "sourceMap": true,
    "rootDir": "./",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noImplicitReturns": true,
    "noFallthroughCasesInSwitch": true,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "target": "ESNext",
    "useDefineForClassFields": false,
    "isolatedDeclarations": true
  }
}
